# Copy this file to .env and fill in your key.
# Get an API key at: https://console.byteplus.com/ark/region:ark+eu-west-1/apiKey
ARK_API_KEY=your_byteplus_ark_api_key_here

# Optional overrides:
# ARK_BASE_URL=https://ark.ap-southeast.bytepluses.com/api/v3
# SEEDANCE_MODEL=dreamina-seedance-2-0-260128
# CORS_ORIGIN=http://localhost:5173

# Model ids for each tier selectable in the UI. Verify these against the
# "Model list" page in your BytePlus console — the values below are best-effort
# guesses and may need correcting (SEEDANCE_MODEL_FAST in particular).
# SEEDANCE_MODEL_MINI=dreamina-seedance-2-0-mini-260615
# SEEDANCE_MODEL_FAST=dreamina-seedance-2-0-fast-260128
# SEEDANCE_MODEL_REGULAR=dreamina-seedance-2-0-260128

# S3 archive for generated videos. IAM user should be scoped to this bucket
# only, with s3:PutObject / s3:GetObject / s3:DeleteObject. Also set a
# lifecycle rule on the bucket (prefix "videos/") to expire objects after
# however many days you want them kept.
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_REGION=us-east-2
# AWS_S3_BUCKET=your-bucket-name
# S3_PRESIGN_EXPIRY_SECONDS=28800
